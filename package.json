{
  "name": "instep",
  "private": true,
  "version": "0.4.0",
  "description": "InStep — the video that waits for you. Body-aware video lessons for Fire TV (Vega OS).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "pnpm --filter @instep/server start",
    "server:dev": "pnpm --filter @instep/server dev",
    "cert": "./scripts/dev-cert.sh",
    "test-tv": "tsx scripts/test-tv.ts",
    "companion:build": "pnpm --filter @instep/companion build",
    "e2e": "pnpm --filter @instep/companion e2e",
    "replay": "tsx scripts/replay.ts",
    "screenshots": "pnpm --filter @instep/companion screenshots",
    "aws:check": "tsx scripts/aws-check.ts",
    "demo-learner": "tsx scripts/demo-learner.ts",
    "dryrun-lessons": "tsx scripts/dryrun-lessons.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1153.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1153.0",
    "@aws-sdk/client-polly": "^3.1153.0",
    "@aws-sdk/client-sts": "^3.1153.0",
    "@instep/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@instep/gate-engine": "workspace:*",
    "@instep/istep-format": "workspace:*"
  }
}
