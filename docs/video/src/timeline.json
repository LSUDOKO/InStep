 "vo": [
  {
   "id": "s2",
   "shot": "s2",
   "at": 14.5,
   "dur": 5.116,
   "text": "Every how-to video plays at the same speed, whether you keep up, or not."
  },
  {
   "id": "s3a",
   "shot": "s3",
   "at": 21.6,
   "dur": 5.456,
   "text": "Falls are the second-leading cause of unintentional injury death worldwide."
  },
  {
   "id": "s3b",
   "shot": "s3",
   "at": 28.2,
   "dur": 6.627,
   "text": "In one survey, three in four people didn't finish their home physical therapy exercises."
  },
  {
   "id": "s3c",
   "shot": "s3",
   "at": 35.7,
   "dur": 6.614,
   "text": "And most cardiac arrests outside hospital happen at home, where nobody is checking your form."
  },
  {
   "id": "s4a",
   "shot": "s4",
   "at": 43.8,
   "dur": 4.486,
   "text": "At least nine in ten deaf children are born to hearing parents."
  },
  {
   "id": "s4b",
   "shot": "s4",
   "at": 48.6,
   "dur": 2.9,
   "text": "And a video can't see whether your hands are right."
  },
  {
   "id": "s5",
   "shot": "s5",
   "at": 55.2,
   "dur": 2.658,
   "text": "InStep is the video that waits for you."
  },
  {
   "id": "cam_a",
   "shot": "s6",
   "at": 60.4,
   "dur": 6.761,
   "text": "Prop up your phone or laptop. It becomes the camera: an external camera, not the TV."
  },
  {
   "id": "cam_b",
   "shot": "s6",
   "at": 67.7,
   "dur": 8.026,
   "text": "Pose tracking runs in its browser. Only body points travel to the TV: numbers, never video."
  },
  {
   "id": "heel_a",
   "shot": "heel",
   "at": 76.7,
   "dur": 10.873,
   "text": "This is Fall Prevention, on the Vega Virtual Device. At each key moment, the lesson pauses, and continues only when your pose is right."
  },
  {
   "id": "heel_b",
   "shot": "heel",
   "at": 97.4,
   "dur": 6.311,
   "text": "It counts your reps and times your balance. If you're stuck, it offers one short, kind tip."
  },
  {
   "id": "safe",
   "shot": "safe",
   "at": 111.9,
   "dur": 9.295,
   "text": "Safety comes first. No balance work until a chair is beside you. And if the camera drops, the lesson stops, and waits."
  },
  {
   "id": "asl_a",
   "shot": "asl",
   "at": 122.6,
   "dur": 4.287,
   "text": "Sign Language for Families teaches hand shapes, letter by letter."
  },
  {
   "id": "asl_b",
   "shot": "asl",
   "at": 131.9,
   "dur": 7.013,
   "text": "The hands are illustrated, and not yet reviewed by Deaf signers. Learn with Deaf teachers, too."
  },
  {
   "id": "kids_a",
   "shot": "kids",
   "at": 141.35,
   "dur": 2.34,
   "text": "For kids, the lesson is a story."
  },
  {
   "id": "kids_b",
   "shot": "kids",
   "at": 150.3,
   "dur": 4.495,
   "text": "The forest waits until they're a tree, a mouse, and a flamingo."
  },
  {
   "id": "more_a",
   "shot": "more",
   "at": 161.4,
   "dur": 7.243,
   "text": "The same engine runs hand rehab, and CPR rhythm: practice only, not certification."
  },
  {
   "id": "more_b",
   "shot": "more",
   "at": 169.5,
   "dur": 4.154,
   "text": "And two people can practise together, each with their own phone."
  },
  {
   "id": "s10a",
   "shot": "s10",
   "at": 175.3,
   "dur": 4.659,
   "text": "A physiotherapist or teacher records a lesson once, on a phone."
  },
  {
   "id": "s10b",
   "shot": "s10",
   "at": 180.6,
   "dur": 6.258,
   "text": "InStep finds the still moments, suggests the steps, and publishes it to the TV."
  },
  {
   "id": "file",
   "shot": "file",
   "at": 188.3,
   "dur": 7.154,
   "text": "Every lesson is an open file, called .istep: a video, plus the poses it waits for."
  },
  {
   "id": "arch_a",
   "shot": "arch",
   "at": 199.1,
   "dur": 7.013,
   "text": "The phone sends body points over a WebSocket. A small server relays them to the TV."
  },
  {
   "id": "s11b",
   "shot": "arch",
   "at": 206.7,
   "dur": 8.061,
   "text": "One pure TypeScript gate engine, shared by the phone, the server and the TV, decides when to move on."
  },
  {
   "id": "s11c",
   "shot": "arch",
   "at": 215.2,
   "dur": 4.283,
   "text": "And the gated video player is open source, for any Vega app."
  },
  {
   "id": "hon",
   "shot": "hon",
   "at": 221.8,
   "dur": 10.3,
   "text": "No learner video leaves the phone. The voices are synthetic, made on this machine. And the AWS coach is built, but switched off."
  },
  {
   "id": "s12",
   "shot": "s12",
   "at": 235.2,
   "dur": 2.48,
   "text": "InStep. The video that waits for you."
  }
 ],
